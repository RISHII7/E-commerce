# ==============================================================================
#  EditorConfig — https://editorconfig.org
# ==============================================================================
#
#  Contributors use different editors on different operating systems. Without an
#  agreed baseline, a repository slowly accumulates mixed indentation, trailing
#  whitespace and line-ending churn, and every diff fills with noise that has
#  nothing to do with the change being reviewed.
#
#  Nearly every modern editor honours this file, most of them natively:
#    - IntelliJ IDEA, WebStorm and the rest of the JetBrains family: built in
#    - Visual Studio Code: install the EditorConfig extension
#    - Visual Studio, Vim, Emacs, Sublime, Notepad++: built in or via plugin
#
#  This file settles formatting once, so nobody has to think about it again.
# ==============================================================================

# Stop EditorConfig searching parent directories. This is the top of the project.
root = true


# ------------------------------------------------------------------------------
#  Defaults for every file
# ------------------------------------------------------------------------------
[*]
charset = utf-8

# LF everywhere in the repository, including on Windows. Git converts to CRLF in
# the working copy where appropriate (see .gitattributes); what is *stored* stays
# LF so the same file never shows as modified purely because of its endings.
end_of_line = lf

# A file with no final newline makes the next change to its last line show up as
# a two-line diff instead of one, and some tools silently mishandle it.
insert_final_newline = true

# Trailing whitespace is invisible, meaningless, and pollutes diffs.
trim_trailing_whitespace = true

indent_style = space
indent_size = 4

# Not universally supported, but respected by JetBrains IDEs. Matches the 120
# column limit that Java code in this project is written to.
max_line_length = 120


# ------------------------------------------------------------------------------
#  Java
# ------------------------------------------------------------------------------
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# Keep import order stable so imports never appear in a diff by accident.
ij_java_class_count_to_use_import_on_demand = 999
ij_java_names_count_to_use_import_on_demand = 999
ij_java_imports_layout = $*, |, java.**, |, javax.**, |, jakarta.**, |, org.**, |, com.**, |, *


# ------------------------------------------------------------------------------
#  XML — Maven and Spring configuration
#
#  Two-space indentation, because XML nests deeply and four spaces pushes real
#  content off the right of the screen.
# ------------------------------------------------------------------------------
[*.xml]
indent_style = space
indent_size = 2
max_line_length = off

[pom.xml]
indent_style = tab
indent_size = 4

[{*.xsd,*.xsl,*.xslt}]
indent_style = space
indent_size = 2


# ------------------------------------------------------------------------------
#  YAML
#
#  YAML is whitespace-significant and tabs are a syntax error in it, so this is
#  a correctness setting rather than a style preference.
# ------------------------------------------------------------------------------
[{*.yml,*.yaml}]
indent_style = space
indent_size = 2
max_line_length = off


# ------------------------------------------------------------------------------
#  JSON
# ------------------------------------------------------------------------------
[{*.json,*.jsonc,.prettierrc,.babelrc}]
indent_style = space
indent_size = 2
max_line_length = off


# ------------------------------------------------------------------------------
#  Properties files
#
#  Spring reads these; a stray trailing space becomes part of a property value
#  and produces bugs that are genuinely hard to see.
# ------------------------------------------------------------------------------
[{*.properties,*.conf,*.ini}]
indent_style = space
indent_size = 2
max_line_length = off


# ------------------------------------------------------------------------------
#  Markdown
#
#  Trailing whitespace is NOT trimmed here. Two trailing spaces are Markdown's
#  hard line break, so trimming them silently changes how a document renders.
# ------------------------------------------------------------------------------
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 120


# ------------------------------------------------------------------------------
#  Shell scripts
#
#  Must be LF. A shell script with CRLF endings fails on Linux with a confusing
#  "bad interpreter" error, because the carriage return becomes part of the
#  interpreter path.
# ------------------------------------------------------------------------------
[{*.sh,*.bash,mvnw}]
indent_style = space
indent_size = 2
end_of_line = lf


# ------------------------------------------------------------------------------
#  Windows scripts
#
#  Must be CRLF. cmd.exe can misparse LF-only batch files, particularly around
#  label and goto handling.
# ------------------------------------------------------------------------------
[{*.bat,*.cmd,mvnw.cmd}]
end_of_line = crlf
indent_style = space
indent_size = 2


# ------------------------------------------------------------------------------
#  Files where tabs are required by the format itself
# ------------------------------------------------------------------------------
[{Makefile,makefile,*.mk}]
indent_style = tab


# ------------------------------------------------------------------------------
#  Generated and vendored files — leave them exactly as generated
# ------------------------------------------------------------------------------
[{.mvn/**,**/target/**,**/generated/**}]
trim_trailing_whitespace = false
insert_final_newline = false


# ------------------------------------------------------------------------------
#  Git's own files
# ------------------------------------------------------------------------------
[{.gitattributes,.gitignore,.gitmessage}]
indent_style = space
end_of_line = lf
