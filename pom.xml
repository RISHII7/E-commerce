<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.app</groupId>
	<artifactId>ecom-application</artifactId>

	<!--
		Version policy (see docs/VERSIONING.md):
		  develop    X.Y.Z-SNAPSHOT   the version being worked towards
		  release/*  X.Y.Z            the exact version being shipped
		  main       X.Y.Z            always matches the tag on that commit
		A -SNAPSHOT is never released and never tagged.
	-->
	<version>0.2.0-SNAPSHOT</version>

	<name>E-Commerce Service</name>
	<description>
		Backend service for an online store, built with Spring Boot 4 and Java 25.
		Provides the REST API behind the product catalogue, inventory, carts, orders,
		payments and customer accounts.
	</description>
	<url>https://github.com/RISHII7/E-commerce</url>
	<inceptionYear>2026</inceptionYear>

	<organization>
		<name>RISHII7</name>
		<url>https://github.com/RISHII7</url>
	</organization>

	<!--
		Declared licence must match the LICENSE file at the repository root.
		An empty <license/> element is worse than declaring nothing at all,
		because licence-scanning tools read it as UNKNOWN rather than
		UNSPECIFIED, which fails compliance checks.
	-->
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
			<comments>
				A permissive licence. The software may be used, copied, modified and
				distributed, including commercially, provided the copyright notice and
				licence text are retained.
			</comments>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>RISHII7</id>
			<name>Rishikesh Palande</name>
			<url>https://github.com/RISHII7</url>
			<organization>RISHII7</organization>
			<organizationUrl>https://github.com/RISHII7</organizationUrl>
			<roles>
				<role>Maintainer</role>
				<role>Developer</role>
			</roles>
			<timezone>Asia/Kolkata</timezone>
		</developer>
	</developers>

	<!--
		Tells Maven, IDEs and dependency scanners where the source lives.
		<tag> stays as HEAD during development; release tooling replaces it
		with the actual tag when a release is cut.
	-->
	<scm>
		<connection>scm:git:https://github.com/RISHII7/E-commerce.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/RISHII7/E-commerce.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/RISHII7/E-commerce</url>
	</scm>

	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/RISHII7/E-commerce/issues</url>
	</issueManagement>
	<properties>
		<!--
			Java 25 is the current Long Term Support release. Spring Boot 4.1
			supports it fully, and an LTS line keeps the project on a supported
			runtime for years rather than the ~6 months a short-term release gets.
			Build and verify with Eclipse Temurin 25 or any other JDK 25 build.
		-->
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
